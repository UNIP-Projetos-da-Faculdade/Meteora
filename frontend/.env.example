# Copie para .env.local. Reinicie npm run dev após alterar estas variáveis.
# URLs completas dos endpoints GET do seu backend Python. Vazio = aguardando dados.
# A conexão HTTP está em src/lib/backend.ts. Contrato documentado em BACKEND.md.
METEORA_STATION_URL=
METEORA_FORECAST_URL=

# Opcional: Bearer token enviado pelo servidor Next.js aos dois endpoints.
# Nunca use NEXT_PUBLIC_ para credenciais.
METEORA_API_TOKEN=
